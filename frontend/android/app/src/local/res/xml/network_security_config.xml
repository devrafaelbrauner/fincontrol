<?xml version="1.0" encoding="utf-8"?>
<!--
  Sabor `local`: texto claro SÓ com o backend do próprio aparelho (127.0.0.1, porta
  sorteada a cada processo). Qualquer outro host segue exigindo HTTPS. Com este arquivo,
  o android:usesCleartextTraffic do manifesto é ignorado (Android 7+, minSdk 24) — vale
  também no debug, cujo manifesto liga o texto claro para o APK de teste em rede local.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
