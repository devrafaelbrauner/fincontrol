# O Vite 7 exige Node ^20.19 || >=22.12. Sem engine-strict o npm só emite um
# warning, e o build morre depois com erro de sintaxe — difícil de ligar à causa.
# Melhor o `npm ci` recusar de cara, com a versão exigida na mensagem.
engine-strict=true

# Só instala versões publicadas há mais de 7 dias (npm 11.10+; a unidade é dia).
# Pacote sequestrado costuma sair do registro em horas ou poucos dias, e a espera
# deixa a instalação fora dessa janela. 7 é o mínimo que o semgrep aceita. O npm 10
# (Node 22 da CI) não conhece a chave e a ignora sem aviso; lá vale só o lockfile.
min-release-age=7
