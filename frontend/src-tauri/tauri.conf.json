{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinControl",
  "identifier": "com.rafaelbrauner.fincontrol",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FinControl",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:1420; script-src 'self' 'sha256-E1sQz/9HiCJOhs0ouPeDzKAQH9XpNxjotrXCUu5LB4Y='; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:*; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "category": "Finance"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDRUI3REE5MTQ3RjU2MTAKUldRUVZuOFVxWDNyckQwQVdsa1VySFBmeDJudFR0V0FrNkpseDh2ckxrOVl5MFhVUVFJU1JsV1gK",
      "endpoints": [
        "https://github.com/devrafaelbrauner/fincontrol-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
