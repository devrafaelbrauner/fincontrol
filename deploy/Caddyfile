# Caddy — HTTPS automático (Let's Encrypt) + reverse proxy para o FinControl.
#
# As três variáveis abaixo vêm de /etc/fincontrol/caddy.env, carregado tanto pelo
# serviço do Caddy (EnvironmentFile=, via drop-in) quanto pelo deploy/deploy.sh
# antes de rodar `caddy validate`. Os dois lados precisam da MESMA fonte: com as
# variáveis vazias este arquivo não é uma config válida — o endereço do site
# some e sobra um bloco sem nome. Isso é proposital: falhar no validate é muito
# melhor do que subir servindo o domínio errado, ou sem contato ACME.
#
# Instalar: copie para /etc/caddy/Caddyfile e rode `sudo systemctl reload caddy`.

{
	# Contato ACME. Sem ele o Let's Encrypt não tem para onde avisar que um
	# certificado está para expirar ou que a renovação automática travou — e a
	# primeira notícia seria o site fora do ar com aviso de segurança.
	email {$FINCONTROL_ACME_EMAIL}
}

{$FINCONTROL_DOMAIN} {
	encode gzip zstd

	# API e feed de calendário (.ics) vão para o backend (uvicorn).
	@backend path /api/* /calendar/*
	handle @backend {
		# Teto do corpo na borda: o multipart é parseado antes da checagem de
		# auth no backend — sem isto, um anônimo encheria o disco via upload.
		request_body {
			max_size 25MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	# Restante: PWA (SPA) — serve os arquivos estáticos e faz fallback para index.html.
	handle {
		root * {$FINCONTROL_FRONTEND_DIST}

		# Assets com hash no nome: imutáveis, cache longo.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Shell do PWA e manifest: sempre revalidar para não servir versão velha.
		# O "/" precisa estar no matcher: header roda antes de try_files, então a
		# raiz (a URL mais acessada) não casaria com /index.html.
		@shell path / /index.html /sw.js /manifest.webmanifest /registerSW.js
		header @shell Cache-Control "no-cache"
		# MIME correto independente do /etc/mime.types da VPS — sem
		# application/manifest+json o Chrome descarta o manifest (PWA não instala).
		header /manifest.webmanifest Content-Type "application/manifest+json"

		try_files {path} /index.html
		file_server
	}

	# O uvicorn marca o cookie de refresh como httpOnly/SameSite; o Caddy garante o HTTPS.
	# HSTS é essencial: o refresh cookie é Secure e o app depende de HTTPS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# CSP: reduz o impacto de XSS/dependência comprometida. style 'unsafe-inline'
		# é exigido pelos estilos inline do React; o resto é tudo same-origin.
		#
		# O sha256 libera UM script inline: o de index.html que aplica o tema antes
		# da primeira pintura. Sem ele o CSP bloqueia o script e o tema só entra no
		# useEffect do React — piscando o tema errado a cada carregamento.
		# ATENÇÃO: mexeu no <script> inline do index.html, recalcule o hash:
		#   deploy/csp-hash.sh
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-E1sQz/9HiCJOhs0ouPeDzKAQH9XpNxjotrXCUu5LB4Y='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Permissions-Policy "geolocation=(), microphone=(), interest-cohort=()"
		-Server
	}
}
