# Ambiente do backend FinControl. Copie para backend/.env e preencha.
# NUNCA versione o .env real (já está no .gitignore).

# --- Obrigatório ---
# Assina os JWT. Gere uma chave longa e aleatória, ex.: openssl rand -hex 32
FINCONTROL_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# --- Recomendado em produção ---
# Criptografa a chave do OpenRouter (Fernet). Se ausente, é derivada do SECRET_KEY.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINCONTROL_FERNET_KEY=
# Marca o cookie de refresh como Secure (só HTTPS). Sempre 1 em produção.
FINCONTROL_COOKIE_SECURE=1
# Diretório do SQLite + uploads/. Deve ser gravável pelo usuário do serviço.
FINCONTROL_DATA=/opt/fincontrol/backend/data

# --- Opcional ---
# CORS: dispensável quando o frontend é servido no mesmo host pelo Caddy.
# Preencha (separado por vírgula) só se acessar a API de outra origem.
FINCONTROL_CORS_ORIGINS=

# IA (OpenRouter) — a chave também pode ser salva pela aba "IA" do app.
# (nada aqui; a chave fica criptografada no banco)

# Push notifications (opcional). Gere com: python -m app.gerar_vapid
FINCONTROL_VAPID_PUBLIC=
FINCONTROL_VAPID_PRIVATE=
FINCONTROL_VAPID_SUBJECT=mailto:voce@exemplo.com

# --- Caddy (lidas pelo serviço do Caddy, não pelo backend) ---
# FINCONTROL_DOMAIN=fincontrol.seudominio.com
# FINCONTROL_FRONTEND_DIST=/opt/fincontrol/frontend/dist
