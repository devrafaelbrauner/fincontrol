# Ambiente do backend FinControl. Copie para backend/.env e preencha.
# NUNCA versione o .env real (já está no .gitignore).

# --- Obrigatório em produção ---
# Ativa as validações de produção: o app RECUSA subir se os segredos abaixo
# forem os defaults inseguros. Use "production" no servidor; deixe vazio/"dev" localmente.
FINCONTROL_ENV=production

# Assina os JWT. Gere uma chave longa e aleatória (>=32 chars): openssl rand -hex 32
# Com FINCONTROL_ENV=production, o app não sobe se esta faltar/for curta/for o default.
FINCONTROL_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Criptografa a chave do OpenRouter (Fernet). OBRIGATÓRIA em produção — se ausente,
# seria derivada do SECRET_KEY (acopla os dois: rotacionar o SECRET_KEY tornaria a
# chave do OpenRouter ilegível). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINCONTROL_FERNET_KEY=

# Marca o cookie de refresh como Secure (só HTTPS). 1 em produção (default quando ENV=production).
FINCONTROL_COOKIE_SECURE=1
# Diretório do SQLite + uploads/. Deve ser gravável pelo usuário do serviço.
FINCONTROL_DATA=/opt/fincontrol/backend/data

# --- Opcional ---
# CORS. NÃO é preciso listar os apps aqui: as origens do Capacitor
# (capacitor://localhost no iOS, https://localhost no Android) já são sempre
# permitidas pelo backend. O web é same-origin e também dispensa.
#
# Use isto só para origens EXTRAS, separadas por vírgula — o valor é somado às
# permitidas, não as substitui. Ex.: um front hospedado em outro domínio.
# FINCONTROL_CORS_ORIGINS=https://outro-front.exemplo.com

# IA (OpenRouter) — a chave também pode ser salva pela aba "IA" do app.
# (nada aqui; a chave fica criptografada no banco)

# Push notifications (opcional). Gere com: python -m app.gerar_vapid
# O SUBJECT precisa ser um mailto: REAL — o Apple Web Push rejeita subject inválido.
FINCONTROL_VAPID_PUBLIC=
FINCONTROL_VAPID_PRIVATE=
FINCONTROL_VAPID_SUBJECT=mailto:voce@exemplo.com
# Hora local (America/Sao_Paulo) do job diário de lembretes; default 8.
# FINCONTROL_LEMBRETE_HORA=8
# FINCONTROL_AGENDADOR=0 desliga o job mesmo com push configurado.

# Backup (deploy/backup.sh + fincontrol-backup.timer)
# Destino local (default /var/backups/fincontrol) e retenção em dias (default 14):
# FINCONTROL_BACKUP_DIR=/var/backups/fincontrol
# FINCONTROL_BACKUP_DIAS=14
# Offsite via rclone (recomendado) — configure com `rclone config` e aponte aqui:
# FINCONTROL_BACKUP_REMOTE=b2:seu-bucket/fincontrol

# --- Caddy: NÃO vão aqui ---
# FINCONTROL_DOMAIN, FINCONTROL_FRONTEND_DIST e FINCONTROL_ACME_EMAIL moram em
# /etc/fincontrol/caddy.env. Este arquivo é EnvironmentFile só do serviço
# `fincontrol` (o backend); o Caddy nunca o lê, então defini-las aqui não teria
# efeito nenhum — e o sintoma seria o Caddy subindo sem domínio.
# Ver deploy/README.md, passo 7.
